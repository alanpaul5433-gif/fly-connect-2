# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase — iOS plist stays machine-local (native build reads it directly).
# firebase_options.dart is the committed FlutterFire source of truth: main.dart
# / main_admin.dart import it, so it must be tracked or clean checkouts & CI
# fail to compile. The keys it holds are public project identifiers, not secrets.
ios/Runner/GoogleService-Info.plist

# Local Claude Code settings
.claude/
