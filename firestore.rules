rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ───────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isBusiness() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'business';
    }
    // Business role is self-serve at signup (see /users create above), so
    // role alone isn't proof of a real business — require the admin-only
    // isVerified flag too before letting an account publish content (M-3).
    function isVerifiedBusiness() {
      return isBusiness() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isVerified == true;
    }
    function isNotBanned() {
      return isAuth() && !get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBanned;
    }
    // The READER's own verified flag — used by SafeCheck's "Verified Users"
    // visibility (H18). Unlike a follower check, this is a property of the
    // caller rather than of each document, so it is cheap and query-compatible.
    function isVerifiedUser() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isVerified == true;
    }
    // A client may change only the listed field names on update.
    // Defensive so no user can escalate role/ban flags via the client.
    function changedOnly(allowedFields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedFields);
    }

    // ── Users ──────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuth();
      // isVerified/verificationStatus must not be settable by the client at
      // create time — otherwise a business signup could write isVerified:
      // true (or verificationStatus:'verified') in the same write that
      // creates the account, fully bypassing isVerifiedBusiness()'s
      // admin-approval gate (found while wiring up the verification-status
      // submission flow below).
      allow create: if isOwner(userId)
        && request.resource.data.role in ['user', 'business']  // admins created server-side
        && request.resource.data.isBanned == false
        && request.resource.data.isVerified == false
        && (!('verificationStatus' in request.resource.data)
            || request.resource.data.verificationStatus in ['none', 'pending']);
      // Users may edit their own profile but not role/ban/verified flags.
      // Admins may touch anything.
      allow update: if isAdmin()
        || (isOwner(userId) && changedOnly([
              'name','phone','photoUrl','bio','airline','airport','position',
              'city','state','hobbies','passportStamps','travelHistory',
              'followerCount','followingCount','postCount',
              'lastSeen','matchType','matchPrefs','settings','lat','lng'
            ]));
      // B3: was admin-only, which made in-app account deletion impossible —
      // deleteAccount() failed with permission-denied on its very first write.
      // Play (since May 2024) and the App Store both require a user to be able
      // to delete their own account, so the owner must be able to delete this
      // document.
      allow delete: if isOwner(userId) || isAdmin();

      // PII (email, phone, fcmToken, dob) lives here instead of on the main
      // doc above, which any authed user can read — Firestore rules can only
      // allow/deny a whole document, not individual fields, so keeping these
      // off the widely-readable doc is the only way to actually restrict them.
      match /private/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }

      match /following/{followedId} {
        allow read: if isAuth();
        allow write: if isOwner(userId);
      }
      match /followers/{followerId} {
        allow read: if isAuth();
        // Only the follower themself may create their own follow relationship
        // (mirrors the posts/{postId}/likes/{userId} ownership pattern) —
        // tightened for C-3, since this doc now drives a real push notification.
        allow create, update: if isOwner(followerId) && isNotBanned()
          && followerId != userId;
        // Deletion is wider than creation on purpose: the follower may unfollow,
        // AND the profile owner may remove a follower — which they must be able
        // to do to erase their own account (B3). Creation stays follower-only so
        // a follow still can't be forged.
        allow delete: if isOwner(followerId) || isOwner(userId);
      }
      match /blocked/{blockedId} {
        // The owner sees and edits their own block list, as before.
        //
        // The second clause lets you read a doc that blocks YOU, which is what
        // makes the "hide users who blocked me" filter possible: clients run
        //   collectionGroup('blocked').where('blockedUid', '==', myUid)
        // and Firestore admits it because that constraint proves every matched
        // doc satisfies this rule. It has to key off the blockedUid FIELD, not
        // blockedId — collection group queries cannot filter on document ids
        // (documentId() there compares full paths), so the id alone is not
        // something a query can constrain on.
        //
        // This deliberately reveals "X blocked me" to the blocked user. It does
        // not reveal the rest of X's list: a doc keyed to a third party fails
        // both clauses, and listing the collection directly stays owner-only.
        allow read: if isOwner(userId)
          || (isAuth() && resource.data.blockedUid == request.auth.uid);
        // Writes stay owner-only — being blocked must not let you unblock
        // yourself by deleting or overwriting the doc.
        allow write: if isOwner(userId);
      }
      match /savedPosts/{postId} {
        // Only the user may see or modify their own bookmarks.
        allow read, write: if isOwner(userId);
      }
      match /trips/{tripId} {
        allow read: if isAuth();
        allow write: if isOwner(userId);
      }
    }

    // ── "Who blocked me", across all users ─────────────────
    // A collection group query is NOT covered by the nested
    // /users/{userId}/blocked/{blockedId} rule above: collection group access
    // is only granted by a rule written with a {path=**} prefix. Without this
    // block the query fails "No matching allow statements" even though a
    // direct get() on the very same document succeeds.
    //
    // Read-only and narrowly conditioned: you may see a block document only
    // when it names you. Writes are deliberately absent here so the owner-only
    // write rule above remains the single authority on modifying a block list.
    match /{path=**}/blocked/{blockedId} {
      allow read: if isAuth() && resource.data.blockedUid == request.auth.uid;
    }

    // ── Posts ──────────────────────────────────────────────
    match /posts/{postId} {
      // B2: `audience` was written by createPost but never enforced — a post
      // marked "Only me" was readable by every signed-in user.
      //
      // Firestore fails the WHOLE query if any matched document is denied, so
      // rules cannot silently filter rows. The contract is therefore: a reader
      // may only run queries provably within this rule — i.e. constrained to
      // audience == 'Everyone', or to their own authorId. Admins are exempt so
      // the moderation console can scan unconstrained.
      //
      // NOTE: a post with no `audience` field fails the first disjunct, so
      // every pre-existing post MUST be backfilled with audience:'Everyone'
      // before this deploys. See scripts/backfill-post-audience.js.
      allow read: if isAuth() && (
           resource.data.audience == 'Everyone'
        || isOwner(resource.data.authorId)
        || isAdmin()
      );
      allow create: if isAuth() && isNotBanned()
        && request.resource.data.authorId == request.auth.uid;
      // Post author may edit own fields; any authed user may increment
      // reportCount / set isReported (reporting flow).
      // L-3: was a single changedOnly(['reportCount','isReported','likeCount',
      // 'commentCount']) branch — any authed user could set any of these to
      // an arbitrary value in one write (e.g. likeCount: 999999). Every real
      // call site only ever moves a counter by exactly ±1 via
      // FieldValue.increment, so require that instead of trusting the client.
      allow update: if isOwner(resource.data.authorId) || isAdmin()
        || (isAuth() && isNotBanned() && changedOnly(['reportCount','isReported'])
            && request.resource.data.reportCount == resource.data.reportCount + 1
            && request.resource.data.isReported == true)
        || (isAuth() && changedOnly(['likeCount'])
            && (request.resource.data.likeCount == resource.data.likeCount + 1
                || request.resource.data.likeCount == resource.data.likeCount - 1))
        || (isAuth() && changedOnly(['commentCount'])
            && (request.resource.data.commentCount == resource.data.commentCount + 1
                || request.resource.data.commentCount == resource.data.commentCount - 1));
      allow delete: if isOwner(resource.data.authorId) || isAdmin();

      match /likes/{userId} {
        allow read: if isAuth();
        // The liker owns their like. create/update stay owner-only.
        allow create, update: if isOwner(userId);
        // H13: the post author may ALSO delete likes on their own post, so
        // deletePost's cascade batch isn't rejected the moment someone else
        // liked. Keyed off the denormalised postAuthorId (written at like time)
        // rather than get()ing the post — a batch cascade would otherwise blow
        // past Firestore's 20-document-access ceiling. Being a liker grants
        // nothing over other people's likes: postAuthorId names the author.
        allow delete: if isOwner(userId)
          || request.auth.uid == resource.data.postAuthorId
          || isAdmin();
      }
      match /comments/{commentId} {
        allow read: if isAuth();
        allow create: if isAuth() && isNotBanned()
          && request.resource.data.authorId == request.auth.uid;
        // H13: comment author, post author (via denormalised postAuthorId), or
        // admin. See the likes rule above for why this avoids get().
        allow delete: if isOwner(resource.data.authorId)
          || request.auth.uid == resource.data.postAuthorId
          || isAdmin();
      }
    }

    // ── Stories ────────────────────────────────────────────
    // One current-story doc per user (doc id == uid), keyed by owner.
    // M-6: replaces the old RAM-only StoryState singleton.
    match /stories/{uid} {
      allow read: if isAuth();
      allow write: if isOwner(uid);
    }

    // ── Chats ──────────────────────────────────────────────
    match /chats/{chatId} {
      allow read: if isAuth() && request.auth.uid in resource.data.participants;
      // Capped at 50 for C-3: bounds the blast radius of the message
      // notification producer (and H-3's unread-count fan-out) to an
      // unbounded number of arbitrary uids. Chat invite/membership UX
      // (who can be added) is a separate, pre-existing concern, out of scope here.
      allow create: if isAuth()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() <= 50;
      // Participants may update lastMessage / unreadCount / typing metadata
      // but not change the participants list.
      allow update: if isAuth()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;

      match /messages/{messageId} {
        allow read: if isAuth()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isAuth()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && isNotBanned()
          && request.resource.data.senderId == request.auth.uid;
        // Tightened: sender may edit own message content OR a participant may add
        // themselves to readBy. No one may forge senderId.
        allow update: if isAuth()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.senderId == resource.data.senderId
          && (isOwner(resource.data.senderId) || changedOnly(['readBy']));
        allow delete: if isOwner(resource.data.senderId) || isAdmin();
      }
      match /typing/{userId} {
        allow read, write: if isAuth()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.auth.uid == userId;
      }
    }

    // ── Events ─────────────────────────────────────────────
    match /events/{eventId} {
      allow read: if isAuth();
      // Only verified-business/admin accounts may create events (matches
      // client-side gate). Business role alone isn't enough — see isVerifiedBusiness().
      allow create: if isAuth() && isNotBanned() && (isVerifiedBusiness() || isAdmin())
        && request.resource.data.createdBy == request.auth.uid;
      // Creator may edit own fields; any authed user may bump rsvpCount
      // via the RSVP flow. Admin may approve/feature.
      // L-3: previously any authed user could add/remove ANY uid to/from
      // rsvpList and set rsvpCount to any value in one write. Every real
      // self-RSVP call site (hasRsvped/removeAttendee's self path) only ever
      // adds/removes the caller's own uid while moving rsvpCount by exactly
      // ±1 in lockstep — require that instead. The event creator/admin
      // removing someone else's RSVP already goes through the first two
      // clauses above (full-field access), so this branch is self-only.
      allow update: if isOwner(resource.data.createdBy) || isAdmin()
        || (isAuth() && changedOnly(['rsvpCount','rsvpList'])
            && ((request.resource.data.rsvpCount == resource.data.rsvpCount + 1
                  && request.resource.data.rsvpList.size() == resource.data.rsvpList.size() + 1
                  && request.auth.uid in request.resource.data.rsvpList
                  && !(request.auth.uid in resource.data.rsvpList))
                || (request.resource.data.rsvpCount == resource.data.rsvpCount - 1
                  && request.resource.data.rsvpList.size() == resource.data.rsvpList.size() - 1
                  && !(request.auth.uid in request.resource.data.rsvpList)
                  && request.auth.uid in resource.data.rsvpList)));
      allow delete: if isOwner(resource.data.createdBy) || isAdmin();

      match /rsvps/{userId} {
        // Previously any authed user could read any attendee's RSVP doc
        // (name, airline, position), letting one business browse a
        // competitor's full attendee roster. Restrict reads the same way
        // writes already are: the attendee themselves, an admin, or the
        // event's own creator.
        allow read: if isOwner(userId) || isAdmin()
          || isOwner(get(/databases/$(database)/documents/events/$(eventId)).data.createdBy);
        // The attendee manages their own RSVP; the event's creator (or an
        // admin) may also write any attendee's doc — needed for the
        // approve/decline/remove-attendee flow in event management.
        allow write: if isOwner(userId) || isAdmin()
          || isOwner(get(/databases/$(database)/documents/events/$(eventId)).data.createdBy);
      }
    }

    // ── Groups ─────────────────────────────────────────────
    match /groups/{groupId} {
      allow read: if isAuth();
      // Only verified-business/admin accounts may create groups (matches
      // client-side gate). Business role alone isn't enough — see isVerifiedBusiness().
      allow create: if isAuth() && isNotBanned() && (isVerifiedBusiness() || isAdmin())
        && request.resource.data.createdBy == request.auth.uid;
      // Admins of the group may update most fields. Joining/leaving mutates
      // members + memberCount \u2014 allow those two fields for any authed user.
      // L-3: previously any authed user could add/remove ANY uid and set
      // memberCount to any value in one write. joinGroup/leaveGroup only
      // ever add/remove the caller's own uid while moving memberCount by
      // exactly \u00b11 in lockstep \u2014 require that. A group admin removing
      // someone else (removeMember, which also touches 'admins') already
      // goes through the admins-membership clause above, so this stays
      // self-only.
      allow update: if isAdmin()
        || (isAuth() && request.auth.uid in resource.data.admins)
        || (isAuth() && changedOnly(['members','memberCount'])
            && ((request.resource.data.memberCount == resource.data.memberCount + 1
                  && request.resource.data.members.size() == resource.data.members.size() + 1
                  && request.auth.uid in request.resource.data.members
                  && !(request.auth.uid in resource.data.members))
                || (request.resource.data.memberCount == resource.data.memberCount - 1
                  && request.resource.data.members.size() == resource.data.members.size() - 1
                  && !(request.auth.uid in request.resource.data.members)
                  && request.auth.uid in resource.data.members)));
      allow delete: if isOwner(resource.data.createdBy) || isAdmin();

      // Broadcast messages sent by a group admin. Persisted as a durable
      // record (not yet fanned out as per-member notifications/push).
      match /broadcasts/{broadcastId} {
        allow read: if isAuth() && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
        allow create: if isAuth()
          && (isAdmin() || request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.admins)
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    // ── Matches ────────────────────────────────────────────
    match /matches/{matchId} {
      allow read: if isAuth()
        && (request.auth.uid == resource.data.userA
            || request.auth.uid == resource.data.userB);
      allow create: if isAuth()
        && request.auth.uid == request.resource.data.userA;
      // Only the reciprocating party (userB - userA is always whoever
      // created the pending doc, i.e. the original liker) may complete a
      // match, and only pending -> matched. Tightened for C-3: the app
      // never updates a match doc for any other transition (passUser()
      // always creates a new doc rather than updating an existing one), so
      // this is also just a more correct rule generally, not only a
      // security tightening for the new push-notification producer.
      allow update: if isAuth()
        && request.auth.uid == resource.data.userB
        && resource.data.status == 'pending'
        && request.resource.data.status == 'matched'
        && changedOnly(['status','matchedAt','chatId']);
      allow delete: if isOwner(resource.data.userA) || isAdmin();
    }

    // ── Notifications ──────────────────────────────────────
    match /notifications/{notificationId} {
      // Recipient may read, mark-read, delete their own.
      allow read: if isOwner(resource.data.userId);
      // Mark-read only \u2014 can't forge content.
      allow update: if isOwner(resource.data.userId)
        && changedOnly(['isRead']);
      allow delete: if isOwner(resource.data.userId);
      // Creation: admins (broadcast) + authed peers writing on specific
      // user-triggered actions like match, RSVP, etc. Restrict to admin
      // unless the caller is writing a notification TO themselves.
      allow create: if isAdmin()
        || (isAuth() && request.resource.data.userId == request.auth.uid);
    }

    // ── SafeChecks ────────────────────────────────────────
    match /safeChecks/{checkId} {
      // H18: "SafeCheck Visibility" (Everyone / Friends Only / Verified Users)
      // was enforced only in Dart while this rule was `if isAuth()`, so any
      // signed-in user could read every check-in — status, free-text message,
      // city and precise lat/lng — whatever the author had chosen. On a
      // personal-safety feature that setting is the entire point.
      //
      // As with posts, Firestore fails the whole query if any matched document
      // is denied, so the client must constrain its query to one of these
      // branches (see SafeCheckProvider).
      //
      // No backfill: check-ins carry a 24h expiresAt, so documents written
      // before `visibility` existed simply age out.
      allow read: if isAuth() && isNotBanned() && (
           resource.data.visibility == 'all'
        || isOwner(resource.data.userId)
        || (resource.data.visibility == 'verified' && isVerifiedUser())
        || (resource.data.visibility == 'friends'
            && request.auth.uid in resource.data.visibleTo)
      );
      allow create: if isAuth() && isNotBanned()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ── Audit Log (admin action history) ───────────────────
    // Previously had no rule at all here, so every logAdminAction() write
    // (best-effort try/catch, see admin_audit_helper.dart) was silently
    // denied by Firestore's default-deny — the "unauthorized attempts are
    // logged" promise never actually persisted anything (L-2). Append-only:
    // no update/delete, to keep the audit trail itself tamper-proof.
    match /audit_log/{entryId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.adminId == request.auth.uid;
    }

    // ── Reports (UGC moderation queue) ─────────────────────
    // Apple App Review 1.2 requires a functional reporting mechanism.
    // Reporters can create; only admins can read/update/delete.
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuth() && isNotBanned()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Promotions ─────────────────────────────────────────
    match /promotions/{promoId} {
      allow read: if isAuth();
      // Was missing a business-role check entirely (M-3) — any authed,
      // non-banned user could create a promotion just by setting
      // businessId to their own uid. Now matches events/groups.
      // A verified business must still go through admin moderation: a
      // non-admin create must set isApproved/isActive to false — otherwise
      // a business could publish a live, approved promotion directly and
      // skip review entirely.
      allow create: if isAuth() && isNotBanned() && (isVerifiedBusiness() || isAdmin())
        && request.resource.data.businessId == request.auth.uid
        && (isAdmin() || (request.resource.data.isApproved == false
                          && request.resource.data.isActive == false));
      // L-3: the ['views','saves','currentRedemptions'] carve-out let any
      // authed user set any of these to an arbitrary value — and no client
      // code writes any of them today (grepped real_providers.dart; the
      // view/save/redeem tracking feature doesn't exist yet), so this was
      // pure unused attack surface. Removed until that feature is built,
      // at which point it should get the same ±1-delta treatment as
      // posts/events/groups above.
      allow update: if isOwner(resource.data.businessId) || isAdmin();
      allow delete: if isOwner(resource.data.businessId) || isAdmin();
    }

    // ── Trips (top-level, in addition to users/{uid}/trips) ─
    match /trips/{tripId} {
      allow read: if isAuth();
      allow create: if isAuth() && isNotBanned()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }
  }
}
