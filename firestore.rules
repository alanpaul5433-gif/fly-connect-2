rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ───────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isBusiness() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'business';
    }
    // Business role is self-serve at signup (see /users create above), so
    // role alone isn't proof of a real business — require the admin-only
    // isVerified flag too before letting an account publish content (M-3).
    function isVerifiedBusiness() {
      return isBusiness() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isVerified == true;
    }
    function isNotBanned() {
      return isAuth() && !get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBanned;
    }
    // A client may change only the listed field names on update.
    // Defensive so no user can escalate role/ban flags via the client.
    function changedOnly(allowedFields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedFields);
    }

    // ── Users ──────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isOwner(userId)
        && request.resource.data.role in ['user', 'business']  // admins created server-side
        && request.resource.data.isBanned == false;
      // Users may edit their own profile but not role/ban/verified flags.
      // Admins may touch anything.
      allow update: if isAdmin()
        || (isOwner(userId) && changedOnly([
              'name','phone','photoUrl','bio','airline','airport','position',
              'city','state','hobbies','passportStamps','travelHistory',
              'followerCount','followingCount','postCount',
              'lastSeen','matchType','matchPrefs','settings','lat','lng'
            ]));
      allow delete: if isAdmin();

      // PII (email, phone, fcmToken, dob) lives here instead of on the main
      // doc above, which any authed user can read — Firestore rules can only
      // allow/deny a whole document, not individual fields, so keeping these
      // off the widely-readable doc is the only way to actually restrict them.
      match /private/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }

      match /following/{followedId} {
        allow read: if isAuth();
        allow write: if isOwner(userId);
      }
      match /followers/{followerId} {
        allow read: if isAuth();
        // Only the follower themself may write their own follow relationship
        // (mirrors the posts/{postId}/likes/{userId} ownership pattern) —
        // tightened for C-3, since this doc now drives a real push notification.
        allow write: if isOwner(followerId) && isNotBanned() && followerId != userId;
      }
      match /blocked/{blockedId} {
        allow read, write: if isOwner(userId);
      }
      match /savedPosts/{postId} {
        // Only the user may see or modify their own bookmarks.
        allow read, write: if isOwner(userId);
      }
      match /trips/{tripId} {
        allow read: if isAuth();
        allow write: if isOwner(userId);
      }
    }

    // ── Posts ──────────────────────────────────────────────
    match /posts/{postId} {
      allow read: if isAuth();
      allow create: if isAuth() && isNotBanned()
        && request.resource.data.authorId == request.auth.uid;
      // Post author may edit own fields; any authed user may increment
      // reportCount / set isReported (reporting flow).
      allow update: if isOwner(resource.data.authorId) || isAdmin()
        || (isAuth() && changedOnly(['reportCount','isReported','likeCount','commentCount']));
      allow delete: if isOwner(resource.data.authorId) || isAdmin();

      match /likes/{userId} {
        allow read: if isAuth();
        allow write: if isOwner(userId);
      }
      match /comments/{commentId} {
        allow read: if isAuth();
        allow create: if isAuth() && isNotBanned()
          && request.resource.data.authorId == request.auth.uid;
        allow delete: if isOwner(resource.data.authorId) || isAdmin();
      }
    }

    // ── Stories ────────────────────────────────────────────
    // One current-story doc per user (doc id == uid), keyed by owner.
    // M-6: replaces the old RAM-only StoryState singleton.
    match /stories/{uid} {
      allow read: if isAuth();
      allow write: if isOwner(uid);
    }

    // ── Chats ──────────────────────────────────────────────
    match /chats/{chatId} {
      allow read: if isAuth() && request.auth.uid in resource.data.participants;
      // Capped at 50 for C-3: bounds the blast radius of the message
      // notification producer (and H-3's unread-count fan-out) to an
      // unbounded number of arbitrary uids. Chat invite/membership UX
      // (who can be added) is a separate, pre-existing concern, out of scope here.
      allow create: if isAuth()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() <= 50;
      // Participants may update lastMessage / unreadCount / typing metadata
      // but not change the participants list.
      allow update: if isAuth()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;

      match /messages/{messageId} {
        allow read: if isAuth()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isAuth()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && isNotBanned()
          && request.resource.data.senderId == request.auth.uid;
        // Tightened: sender may edit own message content OR a participant may add
        // themselves to readBy. No one may forge senderId.
        allow update: if isAuth()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.senderId == resource.data.senderId
          && (isOwner(resource.data.senderId) || changedOnly(['readBy']));
        allow delete: if isOwner(resource.data.senderId) || isAdmin();
      }
      match /typing/{userId} {
        allow read, write: if isAuth()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.auth.uid == userId;
      }
    }

    // ── Events ─────────────────────────────────────────────
    match /events/{eventId} {
      allow read: if isAuth();
      // Only verified-business/admin accounts may create events (matches
      // client-side gate). Business role alone isn't enough — see isVerifiedBusiness().
      allow create: if isAuth() && isNotBanned() && (isVerifiedBusiness() || isAdmin())
        && request.resource.data.createdBy == request.auth.uid;
      // Creator may edit own fields; any authed user may bump rsvpCount
      // via the RSVP flow. Admin may approve/feature.
      allow update: if isOwner(resource.data.createdBy) || isAdmin()
        || (isAuth() && changedOnly(['rsvpCount','rsvpList']));
      allow delete: if isOwner(resource.data.createdBy) || isAdmin();

      match /rsvps/{userId} {
        allow read: if isAuth();
        // The attendee manages their own RSVP; the event's creator (or an
        // admin) may also write any attendee's doc — needed for the
        // approve/decline/remove-attendee flow in event management.
        allow write: if isOwner(userId) || isAdmin()
          || isOwner(get(/databases/$(database)/documents/events/$(eventId)).data.createdBy);
      }
    }

    // ── Groups ─────────────────────────────────────────────
    match /groups/{groupId} {
      allow read: if isAuth();
      // Only verified-business/admin accounts may create groups (matches
      // client-side gate). Business role alone isn't enough — see isVerifiedBusiness().
      allow create: if isAuth() && isNotBanned() && (isVerifiedBusiness() || isAdmin())
        && request.resource.data.createdBy == request.auth.uid;
      // Admins of the group may update most fields. Joining/leaving mutates
      // members + memberCount \u2014 allow those two fields for any authed user.
      allow update: if isAdmin()
        || (isAuth() && request.auth.uid in resource.data.admins)
        || (isAuth() && changedOnly(['members','memberCount']));
      allow delete: if isOwner(resource.data.createdBy) || isAdmin();

      // Broadcast messages sent by a group admin. Persisted as a durable
      // record (not yet fanned out as per-member notifications/push).
      match /broadcasts/{broadcastId} {
        allow read: if isAuth() && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
        allow create: if isAuth()
          && (isAdmin() || request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.admins)
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    // ── Matches ────────────────────────────────────────────
    match /matches/{matchId} {
      allow read: if isAuth()
        && (request.auth.uid == resource.data.userA
            || request.auth.uid == resource.data.userB);
      allow create: if isAuth()
        && request.auth.uid == request.resource.data.userA;
      // Only the reciprocating party (userB - userA is always whoever
      // created the pending doc, i.e. the original liker) may complete a
      // match, and only pending -> matched. Tightened for C-3: the app
      // never updates a match doc for any other transition (passUser()
      // always creates a new doc rather than updating an existing one), so
      // this is also just a more correct rule generally, not only a
      // security tightening for the new push-notification producer.
      allow update: if isAuth()
        && request.auth.uid == resource.data.userB
        && resource.data.status == 'pending'
        && request.resource.data.status == 'matched'
        && changedOnly(['status','matchedAt','chatId']);
      allow delete: if isOwner(resource.data.userA) || isAdmin();
    }

    // ── Notifications ──────────────────────────────────────
    match /notifications/{notificationId} {
      // Recipient may read, mark-read, delete their own.
      allow read: if isOwner(resource.data.userId);
      // Mark-read only \u2014 can't forge content.
      allow update: if isOwner(resource.data.userId)
        && changedOnly(['isRead']);
      allow delete: if isOwner(resource.data.userId);
      // Creation: admins (broadcast) + authed peers writing on specific
      // user-triggered actions like match, RSVP, etc. Restrict to admin
      // unless the caller is writing a notification TO themselves.
      allow create: if isAdmin()
        || (isAuth() && request.resource.data.userId == request.auth.uid);
    }

    // ── SafeChecks ────────────────────────────────────────
    match /safeChecks/{checkId} {
      allow read: if isAuth() && isNotBanned();
      allow create: if isAuth() && isNotBanned()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ── Reports (UGC moderation queue) ─────────────────────
    // Apple App Review 1.2 requires a functional reporting mechanism.
    // Reporters can create; only admins can read/update/delete.
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuth() && isNotBanned()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Promotions ─────────────────────────────────────────
    match /promotions/{promoId} {
      allow read: if isAuth();
      // Was missing a business-role check entirely (M-3) — any authed,
      // non-banned user could create a promotion just by setting
      // businessId to their own uid. Now matches events/groups.
      allow create: if isAuth() && isNotBanned() && (isVerifiedBusiness() || isAdmin())
        && request.resource.data.businessId == request.auth.uid;
      allow update: if isOwner(resource.data.businessId) || isAdmin()
        || (isAuth() && changedOnly(['views','saves','currentRedemptions']));
      allow delete: if isOwner(resource.data.businessId) || isAdmin();
    }

    // ── Trips (top-level, in addition to users/{uid}/trips) ─
    match /trips/{tripId} {
      allow read: if isAuth();
      allow create: if isAuth() && isNotBanned()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }
  }
}
