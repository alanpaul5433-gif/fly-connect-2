<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG-ONLY. Permits cleartext HTTP to the Firebase Emulator Suite so the
     Android E2E harness (integration_test/, run with the
     USE_FIREBASE_EMULATOR dart-define set to true) can reach the emulators,
     which serve plain HTTP. The Auth emulator in particular is REST/HTTP and is
     silently unreachable on Android (targetSdk 28 and up) without this — signup
     and login calls just hang, so every Auth-dependent E2E flow times out.

     Scoped to the emulator hosts only, and this file lives under src/debug, so
     release builds never merge it and production traffic stays TLS-only. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Host loopback as seen from inside the Android AVD (see emulatorHost
             in lib/core/config/emulator_config.dart). -->
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>
