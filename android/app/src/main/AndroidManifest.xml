<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Core -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Push notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Image picking uses the Android Photo Picker (image_picker 0.8.13+), which needs
         NO storage/media permission, so READ_MEDIA_IMAGES / READ_EXTERNAL_STORAGE are
         intentionally NOT declared (avoids Google Play's Photo & Video Permissions policy).
         CAMERA is declared only for optional in-app photo capture (ImageSource.camera). -->
    <uses-permission android:name="android.permission.CAMERA"/>

    <!-- Strip the advertising ID. Firebase Analytics injects com.google.android.gms.permission.AD_ID
         transitively, but FlyConnect serves no ads and uses Analytics only for app-open/event metrics.
         Removing it lets us declare "No advertising ID" on Google Play and keeps Data Safety simpler.
         Analytics still works via the app-instance ID. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove"/>

    <!-- Location (SafeCheck, Nearby Users) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!-- Camera hardware declared as optional so devices without cameras can still install -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false"/>

    <application
        android:label="FlyConnect"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Deep links (App Links) intentionally omitted for v1.0. The app does not
                 yet consume inbound links, and flyconnect.app had no DNS/host, so an
                 autoVerify filter only produced a Play Console "Failed domain checks"
                 warning with no user benefit. Re-add a path-scoped, verified https
                 intent-filter once real deep linking is wired. See docs/deep-links/. -->

            <!-- Custom scheme for OAuth redirects and shortcuts -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="flyconnect"/>
            </intent-filter>
        </activity>

        <!-- FCM default notification channel -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="flyconnect_default"/>

        <!-- Google Maps API key (consumed by google_maps_flutter) -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyDHWqqTekBAR3R9x9rNWQ8CHAIhqZjX3Hk"/>

        <!-- Analytics ad-signal opt-outs. Stripping the AD_ID permission above stops the
             SDK *reading* the advertising ID; these three stop Analytics data being
             shared onward to Google Ads for personalization and audience building.
             Different mechanisms — the permission removal does not imply these.
             Together with $FirebaseAnalyticsWithoutAdIdSupport in ios/Podfile, they make
             "FlyConnect does not track on any platform" true of the binaries rather than
             a claim in the App Review notes (Guideline 5.1.2(i), submission c284c411).
             Reverse these only alongside a paid-acquisition decision — they are what
             Google Ads attribution and remarketing audiences depend on. -->
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false"/>
        <meta-data
            android:name="google_analytics_default_allow_ad_personalization_signals"
            android:value="false"/>
        <meta-data
            android:name="google_analytics_default_allow_ad_user_data"
            android:value="false"/>


        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!-- Package visibility for url_launcher (required on Android 11+) -->
    <queries>
        <!-- Text processing (Flutter default) -->
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>

        <!-- Opening web URLs -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="http"/>
        </intent>

        <!-- Phone dialer -->
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>

        <!-- Email client -->
        <intent>
            <action android:name="android.intent.action.SENDTO"/>
            <data android:scheme="mailto"/>
        </intent>

        <!-- SMS -->
        <intent>
            <action android:name="android.intent.action.SENDTO"/>
            <data android:scheme="smsto"/>
        </intent>
    </queries>
</manifest>
